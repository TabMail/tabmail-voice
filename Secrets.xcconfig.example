// Secrets.xcconfig.example — copy to Secrets.xcconfig and fill in your values.
//
// TabMail Desktop reads these at build time (see project.yml -> configFiles).
// Secrets.xcconfig itself is gitignored; only this template is committed.
//
// If you fork TabMail Desktop, set these to your own values.

// Apple Developer Team ID — used for code signing (CODE_SIGN_STYLE = Automatic).
//   Find it at https://developer.apple.com/account -> Membership (a 10-char ID),
//   or in Xcode -> Settings -> Accounts -> your team.
//   A stable team matters on macOS: the Microphone and Accessibility grants are
//   bound to the code signature, so an ad-hoc signed build loses both on every
//   rebuild. Unit tests can still run ad-hoc (CODE_SIGN_IDENTITY=-).
DEVELOPMENT_TEAM = YOUR_TEAM_ID
