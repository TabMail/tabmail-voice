# The retired Swift app: a checkout may still hold its generated Xcode project (with the signing
# team) and DerivedData, in apps/macos/ or, from before the platform folders, at the root, so
# nothing left there is ever committed.
/apps/macos/
TabMailVoice.xcodeproj/

# Xcode and SwiftPM output (the helpers' package in apps/desktop/native/macos).
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/
build/
.build/
.swiftpm/
*.xcuserstate
xcuserdata/
*.dSYM
*.dSYM.zip
*.xcarchive
*.dmg
.DS_Store
*.swp
*~
.idea/
*.log
*.env

# Local signing and secrets — never committed. Secrets.xcconfig was the retired Swift app's
# signing config; a checkout may still have one, so it stays ignored.
Secrets.xcconfig
Secrets.xcconfig.bak
credentials.json
GoogleService-Info.plist
*.p8
*.p12

# Release toolchain (notarization credentials, account identifiers) stays local.
/fastlane/
/Gemfile
/Gemfile.lock

# Plans and handoffs stay local (never route plans into Companion/).
PLAN_*.md
PLAN_*/

# Agent/automation tooling is private infrastructure — never in the public repo.
AGENTS.md
.agents/
.codex/

# Local build/test scratch.
scratchpad/

# Speech-to-text comparison: your voice recordings and their transcripts stay local.
Scripts/stt-compare/recordings/
Scripts/stt-compare/results/

# Electron app (apps/desktop): dependencies and build output.
apps/desktop/node_modules/
apps/desktop/dist/
apps/desktop/release/
