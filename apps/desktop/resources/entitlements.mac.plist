<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened runtime, not sandboxed: the paste keystroke into other apps and the global hotkey
       both need Accessibility, which the App Sandbox forbids (ADR-DESK-003). -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Calendar and Reminders, for the Answer tool (ADR-DESK-024); the hardened runtime has one
       entitlement for both. -->
  <key>com.apple.security.personal-information.calendars</key>
  <true/>
  <!-- V8 compiles JavaScript at run time. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
