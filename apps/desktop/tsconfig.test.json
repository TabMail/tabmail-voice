{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "noEmit": true
  },
  "exclude": ["test/renderer/**"],
  "include": ["test/**/*.ts", "src/core/**/*.ts", "src/main/**/*.ts", "src/shared/**/*.ts", "vitest.config.mts", "vite.config.mts", "scripts/**/*.mts"]
}
