// Bundles what the browser test pages' code editor takes from CodeMirror
// (`native/shared/browser-pages/codemirror-entry.mjs`) into `codemirror.js` beside it, so the
// pages load from a plain file server in the test machines. The bundle opens with the version of
// every package it holds, which a test compares with package-lock.json, and their licences.
// Run it after a CodeMirror update: `node scripts/browser-pages.mts`.
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { build, type Plugin } from "vite";

const app = join(import.meta.dirname, "..");
const pages = join(app, "native/shared/browser-pages");

/** The package a bundled module comes from: its folder under node_modules and its name. Vite names
 * a module by its path with `/` between folders on every system, Windows too. */
export function packageOf(id: string): { folder: string; name: string } | null {
  const marker = "/node_modules/";
  const at = id.lastIndexOf(marker);
  if (at < 0) return null;
  const rest = id.slice(at + marker.length).split("/");
  const name = rest[0]?.startsWith("@") ? `${rest[0]}/${rest[1]}` : (rest[0] ?? "");
  return { folder: id.slice(0, at + marker.length) + name, name };
}

/** The bundle's opening comment: the packages it holds, at their versions, and each licence. */
export function header(packages: { name: string; version: string; license: string }[]): string {
  const lines = [
    "// Generated by apps/desktop/scripts/browser-pages.mts; do not edit by hand.",
    `// packages: ${JSON.stringify(Object.fromEntries(packages.map(({ name, version }) => [name, version])))}`,
    "/*",
    ...packages.flatMap(({ name, license }) => [`${name}:`, "", license.trim().replaceAll("*/", "* /"), ""]),
    "*/",
  ];
  return lines.join("\n");
}

export const licences: Plugin = {
  name: "licences",
  renderChunk(code, chunk) {
    const folders = new Map<string, string>();
    for (const id of chunk.moduleIds) {
      const found = packageOf(id);
      if (found) folders.set(found.name, found.folder);
    }
    const packages = [...folders].sort(([a], [b]) => a.localeCompare(b)).map(([name, folder]) => ({
      name,
      version: (JSON.parse(readFileSync(join(folder, "package.json"), "utf8")) as { version: string }).version,
      license: readFileSync(join(folder, "LICENSE"), "utf8"),
    }));
    return `${header(packages)}\n${code}`;
  },
};

if (process.argv[1] === import.meta.filename) {
  await build({
    configFile: false,
    logLevel: "warn",
    plugins: [licences],
    build: {
      outDir: pages,
      emptyOutDir: false,
      minify: false,
      lib: { entry: join(pages, "codemirror-entry.mjs"), formats: ["es"], fileName: () => "codemirror.js" },
    },
  });
}
