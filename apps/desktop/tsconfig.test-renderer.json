{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "noEmit": true
  },
  "include": ["test/renderer/**/*.ts", "test/renderer/**/*.tsx", "src/renderer/**/*.ts", "src/renderer/**/*.tsx", "src/shared/**/*.ts", "src/core/**/*.ts"],
  "exclude": ["src/core/**/node*.ts"]
}
