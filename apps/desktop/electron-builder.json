{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "ai.tabmail.voice",
  "productName": "TabMail Voice",
  "copyright": "TabMail",
  "directories": {
    "buildResources": "resources",
    "output": "release"
  },
  "files": [
    "dist/node/**",
    "dist/renderer/**",
    "package.json",
    "!node_modules/@napi-rs/canvas*/**",
    "!node_modules/pdfjs-dist/**",
    "node_modules/pdfjs-dist/package.json",
    "node_modules/pdfjs-dist/LICENSE",
    "node_modules/pdfjs-dist/legacy/build/pdf.mjs",
    "node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs",
    "node_modules/pdfjs-dist/cmaps/**"
  ],
  "extraResources": [
    {
      "from": "resources",
      "to": ".",
      "filter": [
        "trayTemplate*.png"
      ]
    }
  ],
  "asar": true,
  "publish": [
    {
      "provider": "generic",
      "url": "https://cdn.tabmail.ai/releases/voice/macos-arm64",
      "useMultipleRangeRequest": false
    }
  ],
  "mac": {
    "category": "public.app-category.productivity",
    "artifactName": "TabMail-Voice-${version}-${arch}.${ext}",
    "icon": "resources/icon.png",
    "extraResources": [
      {
        "from": "dist/helpers",
        "to": "helpers"
      }
    ],
    "target": [
      {
        "target": "dmg",
        "arch": [
          "arm64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "arm64"
        ]
      }
    ],
    "minimumSystemVersion": "15.0",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "resources/entitlements.mac.plist",
    "entitlementsInherit": "resources/entitlements.mac.plist",
    "extendInfo": {
      "LSUIElement": true,
      "ElectronSquirrelPreventDowngrades": true,
      "NSMicrophoneUsageDescription": "TabMail Voice listens only while you hold the dictation key.",
      "NSCalendarsFullAccessUsageDescription": "TabMail Voice reads your calendars to answer what you ask, and adds the events you confirm.",
      "NSRemindersFullAccessUsageDescription": "TabMail Voice reads your reminders to answer what you ask, and adds the ones you confirm.",
      "NSContactsUsageDescription": "TabMail Voice looks up people in your contacts to answer what you ask, and adds the ones you confirm.",
      "NSAppleEventsUsageDescription": "TabMail Voice uses Notes and Messages to answer what you ask, and adds the notes and sends the messages you confirm."
    }
  },
  "win": {
    "target": "nsis",
    "artifactName": "TabMail-Voice-${version}-windows-${arch}.${ext}",
    "icon": "resources/icon.png",
    "requestedExecutionLevel": "asInvoker",
    "extraResources": [
      {
        "from": "dist/helpers",
        "to": "helpers",
        "filter": [
          "voice-hotkey.exe",
          "voice-windows.exe",
          "voice-microphone.exe",
          "voice-screen-reader.exe",
          "voice-field-reader.exe",
          "voice-productivity.exe"
        ]
      },
      {
        "from": "native/windows/vendor/ia2/LICENSE.txt",
        "to": "helpers/IAccessible2-LICENSE.txt"
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://cdn.tabmail.ai/releases/voice/windows-${arch}",
        "useMultipleRangeRequest": false,
        "publisherName": ["Lisem AI LTD"]
      }
    ]
  },
  "linux": {
    "target": "deb",
    "executableArgs": [
      "--ozone-platform=x11"
    ],
    "artifactName": "TabMail-Voice-${version}-linux-${arch}.${ext}",
    "executableName": "tabmail-voice",
    "syncDesktopName": true,
    "category": "Utility",
    "icon": "resources/linux/icons",
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "native/linux/gnome/voice-caret@tabmail.ai",
        "to": "linux/gnome/voice-caret@tabmail.ai"
      },
      {
        "from": "resources/linux/install-update",
        "to": "linux/install-update"
      },
      {
        "from": "resources/linux/update-keys",
        "to": "linux/update-keys",
        "filter": [
          "*.pem"
        ]
      },
      {
        "from": "dist/helpers",
        "to": "helpers",
        "filter": [
          "voice-hotkey",
          "voice-linux",
          "voice-microphone",
          "voice-screen-reader",
          "voice-field-reader",
          "voice-files",
          "voice-productivity"
        ]
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://cdn.tabmail.ai/releases/voice/linux-${arch}",
        "useMultipleRangeRequest": false
      }
    ],
    "desktop": {
      "entry": {
        "Name": "TabMail Voice",
        "Comment": "Dictate into the app you are using",
        "StartupNotify": "false"
      }
    }
  },
  "deb": {
    "appArmorProfile": "scripts/linux/apparmor-profile.tpl",
    "depends": [
      "libgtk-3-0t64",
      "libnotify4",
      "libnss3",
      "libxss1",
      "libxtst6",
      "xdg-utils",
      "libatspi2.0-0t64 (>= 2.56)",
      "libsecret-1-0",
      "libpulse0",
      "libibus-1.0-5",
      "libtinysparql-3.0-0",
      "libebook-1.2-21t64",
      "libecal-2.0-3",
      "evolution-data-server",
      "localsearch",
      "libicu78",
      "xdg-desktop-portal",
      "xdg-desktop-portal-gnome",
      "openssl",
      "pkexec"
    ],
    "fpm": [
      "native/linux/gnome/voice-caret@tabmail.ai/=/usr/share/gnome-shell/extensions/voice-caret@tabmail.ai",
      "resources/linux/ai.tabmail.voice.install-update.policy=/usr/share/polkit-1/actions/ai.tabmail.voice.install-update.policy"
    ]
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "useZip": true,
    "differentialPackage": false
  },
  "dmg": {
    "artifactName": "TabMail-Voice-latest-${arch}.${ext}",
    "title": "TabMail Voice",
    "background": "dmg-background.png",
    "contents": [
      {
        "x": 130,
        "y": 145,
        "type": "file"
      },
      {
        "x": 410,
        "y": 145,
        "type": "link",
        "path": "/Applications"
      }
    ]
  }
}
