{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "ai.tabmail.voice",
  "productName": "TabMail Voice",
  "copyright": "TabMail",
  "directories": {
    "buildResources": "resources",
    "output": "release"
  },
  "files": ["dist/node/**", "dist/renderer/**", "package.json"],
  "extraResources": [
    { "from": "resources", "to": ".", "filter": ["trayTemplate*.png"] }
  ],
  "asar": true,
  "publish": [{ "provider": "generic", "url": "https://cdn.tabmail.ai/releases/voice/macos-arm64", "useMultipleRangeRequest": false }],
  "mac": {
    "category": "public.app-category.productivity",
    "artifactName": "TabMail-Voice-${version}-${arch}.${ext}",
    "icon": "resources/icon.png",
    "extraResources": [{ "from": "dist/helpers", "to": "helpers" }],
    "target": [
      { "target": "dmg", "arch": ["arm64"] },
      { "target": "zip", "arch": ["arm64"] }
    ],
    "minimumSystemVersion": "15.0",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "resources/entitlements.mac.plist",
    "entitlementsInherit": "resources/entitlements.mac.plist",
    "extendInfo": {
      "LSUIElement": true,
      "ElectronSquirrelPreventDowngrades": true,
      "NSMicrophoneUsageDescription": "TabMail Voice listens only while you hold the dictation key.",
      "NSCalendarsFullAccessUsageDescription": "TabMail Voice reads your calendars to answer what you ask, and adds the events you confirm.",
      "NSRemindersFullAccessUsageDescription": "TabMail Voice reads your reminders to answer what you ask, and adds the ones you confirm.",
      "NSContactsUsageDescription": "TabMail Voice looks up people in your contacts to answer what you ask, and adds the ones you confirm.",
      "NSAppleEventsUsageDescription": "TabMail Voice uses Notes and Messages to answer what you ask, and adds the notes and sends the messages you confirm."
    }
  },
  "win": {
    "target": "nsis",
    "artifactName": "TabMail-Voice-${version}-windows-${arch}.${ext}",
    "icon": "resources/icon.png",
    "requestedExecutionLevel": "asInvoker",
    "extraResources": [
      { "from": "dist/helpers", "to": "helpers", "filter": ["voice-hotkey.exe", "voice-windows.exe"] },
      { "from": "native/windows/vendor/ia2/LICENSE.txt", "to": "helpers/IAccessible2-LICENSE.txt" }
    ],
    "publish": null
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "useZip": true,
    "differentialPackage": false
  },
  "dmg": {
    "artifactName": "TabMail-Voice-latest-${arch}.${ext}",
    "title": "TabMail Voice",
    "background": "dmg-background.png",
    "contents": [
      { "x": 130, "y": 145, "type": "file" },
      { "x": 410, "y": 145, "type": "link", "path": "/Applications" }
    ]
  }
}
