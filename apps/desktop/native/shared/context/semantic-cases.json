      "kind": 1,
      "initial": 2,
      "events": [
        {
          "event": 2,
          "text": "​",
          "decision": 2,
          "repeat": 1
        },
        {
          "event": 3,
          "text": "",
          "decision": 1,
          "repeat": 1
        },
        {
          "event": 1,
          "text": " root only ",
          "decision": 3,
          "repeat": 1
        }
      ],
      "expected": {
        "text": "root only",
        "repeat": 1
      }
    },
    {
      "name": "interrupted empty row never asks for fallback",
