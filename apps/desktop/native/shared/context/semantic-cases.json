{
  "description": "One semantic acquisition contract for every platform. Kind 1 row, 2 heading, 3 link; event 1 root, 2 descendant, 3 complete traversal, 4 interrupted traversal; decision 1 root, 2 descendants, 3 complete, 4 budget full. Expected is private source, before combined redaction/presentation limiting.",
  "cases": [
    {
      "name": "row cells preserve content over a generic name",
      "kind": 1,
      "initial": 2,
      "events": [
        {
          "event": 2,
          "text": " Alice ",
          "decision": 2,
          "repeat": 1
        },
        {
          "event": 2,
          "text": "Ready",
          "decision": 2,
          "repeat": 1
        },
        {
          "event": 3,
          "text": "",
          "decision": 3,
          "repeat": 1
        }
      ],
      "expected": {
        "text": "Alice | Ready",
        "repeat": 1
      }
    },
    {
