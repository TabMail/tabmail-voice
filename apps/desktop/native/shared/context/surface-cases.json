{
  "description": "One terminal surface built from what a helper read of it as one document (ADR-DESK-054): its visible spans and their text, the selections and where the caret is drawn, in the helper's offset unit. The shared core builds the surface's runs (connected when spans meet), the selection (complete only when every selection is wholly inside the visible spans; withheld when unreadable or not fitting the document) and the caret (exact when it is in a span and drawn inside the clip, its leading edge on the clip's edges included; outside the viewport otherwise; unavailable when the helper has none), and refuses text over the byte budget. Run by Rust and every helper that reads a terminal as one document (macOS, Linux); `refused: true` cases are refused.",
  "cases": [
    {
      "name": "one visible line with the caret drawn inside it",
      "request": {
        "surface": {
          "id": 0,
          "frame": [
            0,
            0,
            100,
            50
          ],
          "offsetUnit": "utf16",
          "count": 20,
          "startKnown": false,
          "endKnown": false,
          "bytes": 1000,
          "spans": [
            [
              0,
              11
            ]
          ],
          "texts": [
            "hello world"
          ],
          "selections": [],
          "caret": {
            "offset": 5,
            "frame": [
              10,
              10,
              1,
              16
            ]
          }
        }
      },
      "expected": {
        "surface": {
          "id": 0,
          "frame": [
            0,
            0,
            100,
            50
          ],
          "runs": [
            {
              "id": 0,
              "text": "hello world",
              "connected": false,
              "startKnown": false,
              "endKnown": false
            }
          ],
          "selection": {
            "complete": true,
            "ranges": []
          }
        },
        "caret": {
          "status": "exact",
          "surface": 0,
          "run": 0,
          "offset": 5
        }
      }
    },
