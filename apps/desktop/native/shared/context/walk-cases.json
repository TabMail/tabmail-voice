{
  "description": "The screen walk's rules every helper shares, decided by the shared core (ADR-DESK-054): what to do with each element (node), what a look inside a part read whole for an excluded page decides (look), one step of that look (census), why a walk stops (stop) and its budgets (limits). Each helper's suite runs every case through the C ABI it ships with; `refused: true` cases are refused.",
  "cases": [
    {
      "name": "the walk's budgets",
      "request": {
        "limits": true
      },
      "expected": {
        "nodeBudget": 5000,
        "focusDepth": 200
      }
    },
    {
      "name": "a container is walked into",
      "request": {
        "node": {
          "role": "other",
          "thin": 1
        }
      },
      "expected": {
        "action": "descend",
        "childrenInPage": false
      }
    },
    {
      "name": "a container in a page keeps its children in the page",
      "request": {
        "node": {
          "role": "other",
          "thin": 1,
          "inPage": true
        }
      },
      "expected": {
        "action": "descend",
        "childrenInPage": true
      }
    },
    {
      "name": "a piece of text in a page keeps what it holds in the page, for a helper that walks into one with no name",
      "request": {
        "node": {
          "role": "text",
          "thin": 1,
          "inPage": true
        }
      },
      "expected": {
        "action": "text",
        "childrenInPage": true
      }
    },
    {
      "name": "a field in a page keeps what it holds in the page, for a helper that walks into one not shown safe",
      "request": {
        "node": {
          "role": "field",
          "thin": 1,
          "inPage": true
        }
      },
      "expected": {
        "action": "field",
        "childrenInPage": true
      }
    },
    {
      "name": "a page's control in a row keeps what it holds in the page, for a helper that walks into one with no caption",
      "request": {
        "node": {
          "role": "control",
          "thin": 1,
          "inPage": true,
          "part": true
        }
      },
      "expected": {
        "action": "caption",
        "shown": true,
        "childrenInPage": true
      }
    },
    {
      "name": "a page not excluded is walked into and gives the walk its host",
      "request": {
        "node": {
          "role": "page",
          "thin": 1
        }
      },
      "expected": {
        "action": "descend",
        "childrenInPage": true,
        "host": true
      }
    },
    {
      "name": "a page of an excluded website refuses the window",
      "request": {
        "node": {
          "role": "page",
          "thin": 1,
          "pageExcluded": true
        }
      },
      "expected": {
        "action": "refuse"
      }
    },
    {
      "name": "an excluded page refuses the window even when hidden or thin",
      "request": {
        "node": {
          "role": "page",
          "thin": 1,
          "pageExcluded": true,
          "hidden": true,
          "frame": [
            10,
            10,
            1,
            600
          ],
          "window": [
            0,
            0,
            800,
            600
          ]
        }
      },
      "expected": {
        "action": "refuse"
      }
    },
    {
      "name": "an excluded page with no height at the window's top edge is in it, and refuses it",
