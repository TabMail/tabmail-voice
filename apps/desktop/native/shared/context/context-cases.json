    },
    {
      "name": "a caret starting a line after a no-break space gets no break",
      "request": {
        "beforeCaret": {
          "text": "Why\u00a0",
          "startsLine": true
        }
      },
      "expected": {
        "text": "Why\u00a0"
      }
    },
    {
      "name": "a caret starting a line after a non-ASCII word gets a break",
