{
  "description": "Request rules every helper shares, decided by the shared core (ADR-DESK-054): a focused field read's bound (1 to 20,000 UTF-16 units) and its reply (null when longer, else redacted), and a paste's text (not empty, at most 512 KiB, no NUL) and deadline (later than now, at most 5 s ahead). Each helper's suite runs every case through the C ABI it ships with; `refused: true` cases are refused.",
  "cases": [
    {
      "name": "a field bound at the most a request may ask",
      "request": {
        "field": {
          "maxLength": 20000
        }
      },
      "expected": {
        "maxLength": 20000
      }
    },
    {
      "name": "a field bound of one unit",
      "request": {
        "field": {
          "maxLength": 1
        }
      },
      "expected": {
        "maxLength": 1
      }
    },
    {
      "name": "no text read from the field",
      "request": {
        "field": {
          "maxLength": 20000,
          "text": null
        }
      },
      "expected": {
        "value": null
      }
    },
    {
      "name": "a field's text, its secret-looking part taken out",
      "request": {
        "field": {
          "maxLength": 20000,
          "text": "Draft reply. password: hunter2x"
        }
      },
      "expected": {
        "value": "Draft reply. password: [redacted]"
      }
    },
    {
      "name": "a rich editor's text, its block breaks as the line breaks they are",
      "request": {
        "field": {
          "maxLength": 20000,
          "text": "Hi All,\nWhy does it move?\n\n--"
        }
      },
      "expected": {
        "value": "Hi All,\nWhy does it move?\n\n--"
      }
    },
    {
      "name": "a terminal's field: the box around its cursor, its pane's rows joined by the core's breaks (U+2029)",
      "request": {
        "field": {
          "maxLength": 20000,
          "viewport": {
            "surfaces": [
              {
                "id": 1,
                "frame": [
                  0,
                  0,
                  400,
                  200
                ],
                "runs": [
                  {
                    "id": 1,
                    "text": "build ok.  │ $ echo one\nDone.      │ one\nlog:       │ Note:\n           │",
                    "connected": false,
                    "startKnown": false,
                    "endKnown": false
                  }
                ],
                "selection": {
                  "complete": true,
                  "ranges": []
                }
              }
            ],
            "focusedSurface": 1,
            "complete": true,
            "caret": {
              "status": "exact",
              "surface": 1,
              "run": 1,
              "offset": 59
            }
          }
        }
      },
      "expected": {
        "value": " $ echo one\u2029 one\u2029 Note:\u2029"
      }
    },
    {
      "name": "a terminal's field: a program's input between its rules",
