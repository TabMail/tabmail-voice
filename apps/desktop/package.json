{
  "desktopName": "ai.tabmail.voice.desktop",
  "name": "tabmail-voice",
  "productName": "TabMail Voice",
  "version": "0.1.3",
  "description": "Dictation anywhere: hold a key, speak, and the text is typed where you are writing.",
  "license": "MPL-2.0",
  "author": "TabMail <hello@tabmail.ai>",
  "homepage": "https://tabmail.ai",
  "private": true,
  "main": "dist/node/main/index.js",
  "scripts": {
    "gen:registries": "node scripts/gen-registries.mts",
    "compile:native": "node scripts/build-native.mts",
    "prebuild:main": "npm run gen:registries",
    "build:main": "node -e \"require('node:fs').rmSync('dist/node', { recursive: true, force: true })\" && tsc -p tsconfig.main.json",
    "prebuild:renderer": "npm run gen:registries",
    "build:renderer": "vite build",
    "build": "npm run compile:native && npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "start:linux": "npm run build && electron --ozone-platform=x11 .",
    "pretypecheck": "npm run gen:registries",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.test-renderer.json --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "pretest": "npm run gen:registries",
    "test": "vitest run",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "preview": "npm run build:renderer && electron scripts/preview/index.mts"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@napi-rs/keyring": "2.0.0",
    "abort-controller": "3.0.0",
    "electron-updater": "6.8.9",
    "jsonc-parser": "3.3.1",
    "pdfjs-dist": "6.3.289",
    "quickjs-emscripten-core": "0.32.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "web-streams-polyfill": "4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "happy-dom": "20.14.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "allowScripts": {
    "electron-winstaller": false
  }
}
