{
  "name": "tabmail-voice",
  "productName": "TabMail Voice",
  "version": "0.1.0",
  "description": "Dictation anywhere: hold a key, speak, and the text is typed where you are writing.",
  "license": "MPL-2.0",
  "author": "TabMail <hello@tabmail.ai>",
  "homepage": "https://tabmail.ai",
  "private": true,
  "main": "dist/node/main/main.js",
  "scripts": {
    "compile:native": "node scripts/build-native.mjs",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run compile:native && npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "allowScripts": {
    "electron-winstaller": false
  }
}
